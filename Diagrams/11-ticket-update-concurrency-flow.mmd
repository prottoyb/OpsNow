---
title: OpsNow — Ticket Mutation & Concurrency Flow
---
flowchart LR
    classDef fail fill:#FEE2E2,stroke:#DC2626
    classDef ok fill:#D1FAE5,stroke:#0F766E
    classDef note fill:#F5F6FA,stroke:#D1D5DB,text-align:left

    REQ["React UI — one of four mutation endpoints:<br/>PATCH /tickets/:id (subject/description/category)<br/>PATCH /tickets/:id/assignment · /:id/status · /:id/priority"]

    subgraph GUARDS["Guards — global, run before route validation and controller/service execution"]
        direction TB
        AUTH{"JwtAuthGuard:<br/>valid access token?"}
        ROLES{"RolesGuard:<br/>route declares @Roles(STAFF)?<br/>(only /assignment and /priority do)"}
        AUTH -->|yes| ROLES
    end
    REQ --> AUTH
    AUTH -->|no| E401["401"]:::fail
    ROLES -->|"staff-only route,<br/>caller isn't staff"| E403g["403 — blocked at the<br/>route guard, before<br/>validation ever runs"]:::fail

    VALIDATE["Global ValidationPipe<br/>validates &amp; transforms the request body —<br/>runs before the controller/service on<br/>every route, ahead of any DB read"]
    ROLES -->|"pass, or no @Roles<br/>declared on this route"| VALIDATE
    VALIDATE -->|malformed body| E400a["400"]:::fail

    subgraph SERVICE["Ticket Service"]
        direction TB
        LOAD["getVisibleTicketOrThrow(id, user)<br/>RBAC- + row-visibility-scoped read"]
        BIZCHECK{"Business-rule / ownership check —<br/>content and order is endpoint-specific,<br/>see note below"}
        LOAD --> BIZCHECK
    end
    VALIDATE -->|valid| LOAD
    LOAD --> FOUND{"exists and<br/>visible to caller?"}
    FOUND -->|no| E404["404"]:::fail
    FOUND -->|yes| BIZCHECK
    BIZCHECK -->|"ownership/role<br/>rule fails"| E403s["403"]:::fail
    BIZCHECK -->|"status: already<br/>in that status"| E400b["400 (no-op)"]:::fail
    BIZCHECK -->|"status: not allowed<br/>by transition matrix"| E403t["403<br/>(invalid transition)"]:::fail

    subgraph TXN["Prisma $transaction"]
        direction TB
        CAS["ticket.updateMany WHERE id = :id<br/>AND ticketVisibilityWhere(user)<br/>AND &lt;field just read&gt; = &lt;value just read&gt;<br/>— updatedAt (edit) / assigneeId (assign) /<br/>priority / status — no version column"]
        CASCHECK{"rows updated<br/>=== 1?"}
        SLAHOOK["Conditional SLA side effect —<br/>only entering/leaving OnHold, resolution,<br/>reopen, or a priority change"]
        HIST["TicketHistory row(s)<br/>— same transaction, same commit"]
        CAS --> CASCHECK
        CASCHECK -->|1| SLAHOOK --> HIST
    end
    BIZCHECK -->|"passes /<br/>allowed"| CAS
    CASCHECK -->|"0 — someone else<br/>changed that exact<br/>field first"| E409["409 Conflict"]:::fail

    COMMIT["Transaction commits<br/>(ticket update + SLA row + history<br/>are atomic together)"]:::ok
    HIST --> COMMIT
    AUDITLOG["AuditService.record(...)<br/>deliberately OUTSIDE the transaction —<br/>a failed audit write can't fail or undo the update"]
    COMMIT --> AUDITLOG --> RESP["200 OK — updated ticket"]:::ok

    BIZNOTE["Business-rule check, per endpoint: field edit (PATCH /:id) — a non-staff requester is blocked<br/>once status has left New. Status change — no-op check (400) runs first, then the transition-matrix<br/>check (403), then a staff-or-reopening check (403; reopen is a requester's only self-service move).<br/>Assignment / priority — RolesGuard already restricts the route to staff before validation runs (see<br/>GUARDS above); the service repeats the staff check as defense-in-depth, ahead of its own load."]:::note

    PRISMAERR["Underlying Prisma errors are mapped, not left raw:<br/>P2003 (FK violation) -&gt; 400 · P2025 (not found) -&gt; 404.<br/>No generic transaction-failure path exists beyond<br/>these and the CAS conflict above."]:::note
