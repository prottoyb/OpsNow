# Copy this file to .env and fill in real local values.
# .env is gitignored and must never be committed.

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/opsnow_dev?schema=public"

# Application environment: development | test | production
NODE_ENV=development

# Port the NestJS HTTP server listens on.
PORT=3000

# Secret used to sign JWT access tokens. Generate a real value locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this placeholder and never commit a real secret.
JWT_ACCESS_SECRET=replace-with-a-long-random-locally-generated-secret

# Access token lifetime (jsonwebtoken duration string, e.g. "15m", "1h").
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime in seconds (default: 604800 = 7 days).
REFRESH_TOKEN_TTL_SECONDS=604800
