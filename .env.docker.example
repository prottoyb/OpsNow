# ---------------------------------------------------------------------------
# Environment for the Docker Compose stack (docker-compose.yml).
#
#   cp .env.docker.example .env
#
# Compose reads `.env` from the repository root. That file is gitignored and
# must never be committed. This template contains NO real values: the two
# required variables have no default in docker-compose.yml on purpose, so the
# stack refuses to start rather than running on a placeholder.
#
# This is separate from backend/.env, which configures a backend run directly
# on the host with `npm run start:dev`. The two do not share a database.
# ---------------------------------------------------------------------------

# --- required ---------------------------------------------------------------

# Password for the containerised Postgres. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# base64url is suggested because this value is interpolated into a
# postgresql:// URL. A password containing @ : / ? # or % would have to be
# percent-encoded there, and getting that wrong produces a connection error
# that looks like a wrong password.
POSTGRES_PASSWORD=

# Secret used to sign JWT access tokens. Must be at least 32 characters —
# the application's Joi schema refuses to boot otherwise. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates every access token already issued.
JWT_ACCESS_SECRET=

# --- database ---------------------------------------------------------------
# The database is deliberately NOT called opsnow_dev: the compose stack keeps
# its own Postgres in its own volume and must not be confused with, or be
# able to touch, a developer's local database.
POSTGRES_USER=opsnow
POSTGRES_DB=opsnow

# Host port for the containerised Postgres, bound to 127.0.0.1. 5433 rather
# than 5432 so it cannot collide with a Postgres already on the host.
POSTGRES_HOST_PORT=5433

# --- web --------------------------------------------------------------------
# Where the application is served. The API is reached through this same
# origin at /api — it is not published separately, and must not be.
FRONTEND_HOST_PORT=8080

# --- tokens -----------------------------------------------------------------
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=604800

# --- auth throttle (ADR-026) ------------------------------------------------
# Applies to /auth/login, /auth/register and /auth/refresh, each on its own
# counter, keyed on the client IP. Raise the limit if many real users share
# one egress IP. There is no value that disables it.
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# --- API documentation (ADR-027) --------------------------------------------
# Publishes the Swagger UI and its OpenAPI document at /api/docs, which has no
# authentication in front of it and describes every route, role gate and
# response shape in the application. Defaults to ON outside production and OFF
# in production, so publishing it in production is a deliberate opt-in rather
# than something a deployment has to remember to turn off. Leave unset to take
# the default for the environment.
# SWAGGER_ENABLED=true

# --- AI ticket assistant (optional; OFF unless set) -------------------------
# Leave AI_API_KEY empty to run without AI. Setting it means ticket text and
# knowledge-base excerpts are sent to the provider (ADR-023).
# Only `disabled` and `anthropic` are accepted here: the compose stack runs
# with NODE_ENV=production, and the mock provider — which fabricates output —
# is rejected outright in production.
AI_PROVIDER=
AI_API_KEY=
