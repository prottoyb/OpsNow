# Keep the build context small and — more importantly — keep local secrets
# and local build output out of the image entirely.

# Never. `.env` holds the real DATABASE_URL and JWT_ACCESS_SECRET; copying it
# into a layer would bake them into the image for anyone who can pull it.
.env
.env.*
!.env.example

node_modules
dist
coverage
*.tsbuildinfo

# Tests and tooling are not needed by the runtime image, and the build stage
# compiles from src/ only.
test
eslint.config.mjs
**/*.spec.ts

.git
.gitignore
Dockerfile
.dockerignore
*.log
