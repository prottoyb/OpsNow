# Copy this file to .env and fill in real local values.
# .env is gitignored and must never be committed.

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/opsnow_dev?schema=public"

# Application environment: development | test | production
NODE_ENV=development

# Port the NestJS HTTP server listens on.
PORT=3000

# Secret used to sign JWT access tokens. Generate a real value locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this placeholder and never commit a real secret.
JWT_ACCESS_SECRET=replace-with-a-long-random-locally-generated-secret

# Access token lifetime (jsonwebtoken duration string, e.g. "15m", "1h").
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime in seconds (default: 604800 = 7 days).
REFRESH_TOKEN_TTL_SECONDS=604800

# --- AI ticket assistant (optional; the feature is OFF unless a key is set) ---
# Leave AI_API_KEY empty to run without AI. Setting it means ticket text and
# knowledge-base excerpts are sent to the provider (see ADR-023).
# AI_PROVIDER: disabled | anthropic | mock (mock is rejected in production;
# it returns clearly-marked canned output for demos and tests only).
# The key is deliberately NOT named ANTHROPIC_API_KEY, so an ambient vendor
# key in your shell can never switch this on by accident.
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL defaults to claude-opus-5; AI_TIMEOUT_MS defaults to 15000.
